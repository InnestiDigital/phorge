{
  "name": "@innestidigital/phorge",
  "version": "1.5.0",
  "description": "Zero-LLM static intelligence layer for Laravel coding agents. Provides commit-mining, code graphs, anchor resolution, and plan validation as deterministic signals before agent planning.",
  "license": "MIT",
  "type": "module",
  "main": "src/index.ts",
  "bin": {
    "phorge": "bin/phorge.js",
    "phorge-benchmark": "bin/phorge-benchmark.js"
  },
  "files": [
    "src",
    "bin",
    "tsconfig.json",
    "README.md",
    "LICENSE",
    ".claude-plugin",
    "skills",
    "hooks",
    ".mcp.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "cli": "tsx bin/phorge.ts",
    "bench": "tsx bin/phorge-benchmark.ts",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build",
    "version": "node scripts/sync-plugin-version.mjs && git add .claude-plugin/"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "php-parser": "^3.5.1",
    "ts-morph": "^28.0.0",
    "tsx": "^4.19.0",
    "yaml": "^2.8.3",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "laravel",
    "coding-agent",
    "static-analysis",
    "git-mining",
    "code-graph",
    "ai",
    "agent-tools"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/InnestiDigital/phorge.git"
  },
  "bugs": {
    "url": "https://github.com/InnestiDigital/phorge/issues"
  },
  "homepage": "https://github.com/InnestiDigital/phorge#readme",
  "publishConfig": {
    "access": "public"
  }
}
